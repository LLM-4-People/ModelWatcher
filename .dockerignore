__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.git/
.gitignore
# Env files hold provider API keys; the image never needs them
.env*
# Local configs hold deployment secrets and are mounted at runtime; only config/*.example ships
config/*.yaml
config/*.yml
data/
.venv/
node_modules/
# The image builds its own stylesheet in the css-builder stage; never ship a local build
frontend/tailwind.min.css
tests/
scripts/
