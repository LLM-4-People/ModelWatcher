# ModelWatcher - environment variables
#
# This file documents all environment variables the application recognizes.
# Copy to .env and fill in the values for your deployment.
# Unresolved ${VAR_NAME} references in models.yaml stay as literal strings
# (providers with unresolved keys will fail with an auth error on first test).

# ── Server binding ──────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8080

# ── Timezone ────────────────────────────────────────────────────────────────
TZ=UTC

# ── Docker Compose ──────────────────────────────────────────────────────────
# Restart policy for the container: unless-stopped, always, on-failure, no
restart=unless-stopped

# ── Reverse proxy ───────────────────────────────────────────────────────────
# Comma-separated list of trusted proxy IPs for X-Forwarded-For header parsing.
# Set to your nginx/proxy IP. Use "*" to trust all (not recommended).
FORWARDED_ALLOW_IPS=127.0.0.1

# ── Provider API keys ───────────────────────────────────────────────────────
# Add one per provider in config/models.yaml. Names must match the ${VAR_NAME}
# references in your models.yaml. These are examples - rename to match your config.

DS_API_KEY=
LILAC_API_KEY=
NANOGPT_API_KEY=
NW_API_KEY=
OLLAMA_API_KEY=
WAFER_API_KEY=
ZAI_API_KEY=
HYPER_API_KEY=

# ── Optional: override config file paths ────────────────────────────────────
# MW_MODELS_YAML=/path/to/models.yaml     # Override models config file
# MW_APP_YAML=/path/to/app.yaml           # Override app config file
# MW_AUDITS_YAML=/path/to/audits.yaml     # Override audits config file
# MW_DB_NAME=metrics.db                    # Override SQLite database filename
# MW_BUILT_CSS_PATH=/opt/frontend/tailwind.min.css  # Override built CSS path

# ── Optional: disable tests for diagnostics ─────────────────────────────────
# MW_DISABLE_TESTS=1                       # Skip scheduler, model_info, favicons, config_watcher
